# Copie para .env e preencha. O .env nunca vai para o repositório.
# Modelo de linguagem (só é usado pelo extrator LLM e pelo agente explicador).
# Formato provedor:modelo. Para o Groq, instale o extra: uv pip install --python .venv -e ".[groq]"
MODELO_LLM=groq:openai/gpt-oss-120b
GROQ_API_KEY=
# Extrator de requisitos da rota POST /contrato/executar: regras (padrão, sem LLM) ou llm.
# Com llm sem modelo/chave configurados, o servidor avisa no log e usa as regras.
EXTRATOR=regras
# Pasta das saídas lidas pelo agente explicador (saidas/<id_formando>/).
SAIDAS_DIR=saidas
# Banco SQLite das sessões do AgentOS.
BANCO_SQLITE=dados/radar_vagas.db
# Cache das extrações de requisitos (versionado no repositório).
CACHE_REQUISITOS=dados/cache_requisitos.json
PORTA=7777
AGNO_TELEMETRY=false
